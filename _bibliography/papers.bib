@article{treadway_disentangling_2025,
	title = {Disentangling grammar and experience: {On} the role of environmental exposure to {Spanish}-{English} code-switching},
	volume = {11},
	copyright = {Copyright (c) 2025 Hannah G. Treadway, Josh L. Higdon, Jorge R. Valdés Kroff},
	issn = {2385-4138},
	shorttitle = {Disentangling grammar and experience},
	url = {https://revistes.uab.cat/isogloss/article/view/v11-n4-treadway-higdon-valdeskroff},
	doi = {10.5565/rev/isogloss.519},
	abstract = {Code-switching (CS) processing is subject to modulation by language-internal properties and extralinguistic factors, including the distributional patterns of bilingual language production specific to a given bilingual community. To tease apart the roles of grammar and experience in CS processing, a group of advanced L1 English, L2 Spanish learners (n=39) immersed in an environment with ubiquitous code-switching (U.S. east coast) participated in a reading-while-eye-tracking experimental task. Spanish-English CS asymmetries present in the production of bilingual compound verbs and determiner-noun switches that differ in their regional use and frequency were tested. Results reveal that L2 learners are sensitive to the distributional production frequencies of CS present in their interactive context during online processing. However, the onset of these effects is somewhat delayed, indicating that the impact of environmental production frequencies may surface during later stage processing for L2 learners. Results are discussed in the context of experience-based frameworks of sentence processing.},
	language = {en},
	number = {4},
	urldate = {2025-09-07},
	journal = {Isogloss. Open Journal of Romance Linguistics},
	author = {Treadway, Hannah and Higdon, Josh and Kroff, Jorge Valdés},
	month = sep,
	year = {2025},
	keywords = {code-switching, experience-based processing, eye-tracking, L2 learners, Spanish-English},
	pages = {1--27},
	file = {Full Text PDF:files/669/Treadway et al. - 2025 - Disentangling grammar and experience On the role of environmental exposure to Spanish-English code-.pdf:application/pdf},
}

@article{marino_influence_2025,
	title = {The {Influence} of {Community}-{Specific} {Code}-{Switching} {Norms} on {Online} {Comprehension} in {Early} {Spanish}-{English} {Bilinguals}},
	volume = {27},
	copyright = {Copyright (c) 2025 Cassidy Marino},
	issn = {2638-0668},
	url = {https://journals.flvc.org/UFJUR/article/view/138822},
	doi = {10.32473/ufjur.27.138822},
	abstract = {In research on Spanish-English bilingual code-switching (CS), bilingual compound verbs (BCVs) have been shown to occur at different frequencies in distinct bilingual communities. This paper proposes production frequencies play an important role in the online processing of Spanish-English CS. Sixteen early Spanish-English bilinguals participated in a reading-while-eye-tracking study where they read sentences containing BCVs that are attested in their bilingual community and those that are syntactically plausible, yet unattested in the same community. Participants were expected to show a processing cost for the light verb (LV) condition with the switch occurring at the lexical infinitive, as this switch is unattested in this participant group’s speech community. Participants were also expected to display this sensitivity during earlier stage processing when compared to age-matched learners of Spanish. The results showed a trend of longer reading time for the LV at lexical infinitive switch that became most robust in the spillover region. A z-scored analysis of an offline acceptability assessment of the presented stimuli revealed a strong dispreference for the unattested switch. These results indicate that prior exposure to language had an important impact in online and offline processing of Spanish-English CS.\&nbsp;},
	language = {en},
	urldate = {2026-02-09},
	journal = {UF Journal of Undergraduate Research},
	author = {Marino, Cassidy and Treadway, Hannah},
	month = nov,
	year = {2025},
	keywords = {bilingualism, code-switching, psycholinguistics},
	file = {Full Text PDF:files/1459/Marino - 2025 - The Influence of Community-Specific Code-Switching Norms on Online Comprehension in Early Spanish-En.pdf:application/pdf},
}

